{
  "name": "cwmoss/slowfoot",
  "description": "your friendly static site generator",
  "version": "1.0",
  "autoload": {
    "files": [
      "src/_functions.php",
      "src/lolql/lolql.php"
    ],
    "psr-4": {
      "slowfoot\\": "src",
      "slowfoot_plugin\\markdown\\": "plugins/markdown/src",
      "slowfoot_plugin\\sanity\\": "plugins/sanity/src",
      "slowfoot_plugin\\phuety\\": "plugins/phuety/src"
    }
  },
  "repositories": [
    {
      "type": "git",
      "url": "https://github.com/cwmoss/final-cli"
    }
  ],
  "bin": [
    "bin/slowfoot"
  ],
  "scripts": {
    "make-docs": "@php bin/slowfoot build -d=docs -f -p=/slowfoot"
  },
  "require": {
    "php": ">=8.4",
    "composer-runtime-api": "^2.2.2",
    "erusev/parsedown": "^1.7",
    "jbroadway/urlify": "^1",
    "ovidigital/js-object-to-json": "^1.0",
    "league/glide": "^2.0",
    "league/flysystem-memory": "^2.0",
    "phplucidframe/console-table": "^1.2",
    "benjaminhoegh/parsedown-extended": "^1.2",
    "cwmoss/wrun": "dev-main",
    "cwmoss/phuety": "dev-main",
    "cwmoss/final-cli": "dev-main",
    "clue/framework-x": "dev-main",
    "sanity/sanity-php": "^1.5",
    "symfony/yaml": "^4.0|^5.0|^6.0|^7.0|^8.0",
    "meyfa/php-svg": "^0.16.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": ">=11"
  },
  "replace": {
    "symfony/polyfill-php80": "*",
    "paragonie/sodium_compat": "*",
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-mbstring": "*"
  }
}
